# Neon — connection string from your Neon project dashboard
DATABASE_URL=

# QuickBooks Online — from developer.intuit.com
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
QBO_ENVIRONMENT=sandbox

# ── Neon Auth ─────────────────────────────────────────────────────────────────
# Found in Neon Console → Auth → Configuration → "Auth base URL"
NEON_AUTH_BASE_URL=

# Generate with: openssl rand -base64 32
# Must be at least 32 characters.
NEON_AUTH_COOKIE_SECRET=

# ── Dev-only auth override ────────────────────────────────────────────────────
# Set to "true" ONLY for local development to skip Neon Auth and use the
# dev_user cookie / /pick-user page. This is a passwordless auth bypass — leave
# it unset/false everywhere else. It is also hard-disabled when VERCEL_ENV is
# "production" regardless of this value (see lib/auth/dev-auth.ts).
NEXT_PUBLIC_DEV_AUTH=false

# ── Gmail SMTP — customer reminder emails ─────────────────────────────────────
# Generate an App Password at: myaccount.google.com/apppasswords (requires 2FA)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Resend — landing page "request info" lead emails ──────────────────────────
# API key from resend.com/api-keys. Sends from leads@squeakycleanboats.com, so
# that domain must be added and verified in the Resend dashboard first.
RESEND_API_KEY=

# ── Vercel AI Gateway: /quote boat-model AI fallback (optional) ──────────────
# Key from vercel.com/[team]/~/ai-gateway/api-keys. Only used when a typed
# boat isn't found in the boat_models catalog; feature no-ops without it.
AI_GATEWAY_API_KEY=

# ── Vercel Cron secret ────────────────────────────────────────────────────────
# Set in Vercel dashboard → Settings → Environment Variables, used to authenticate cron requests
CRON_SECRET=

# ── MCP server ────────────────────────────────────────────────────────────────
# Optional. The local MCP server (pnpm mcp) acts as this owner user for all
# actions. If left blank, it auto-detects the first user with role='owner'.
MCP_OWNER_USER_ID=
